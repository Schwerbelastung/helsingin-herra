{
  "name": "helsingin-herra",
  "version": "1.6.3",
  "description": "Helsingin Herra — real estate tycoon set in Helsinki",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "postbuild": "node -e \"const fs=require('fs'),f=fs.readdirSync('dist').find(f=>/\\.exe$/.test(f));if(f){fs.copyFileSync('dist/'+f,f);console.log('Copied',f);}else{console.warn('No .exe found in dist/');}\""
  },
  "build": {
    "appId": "com.schwerbelastung.helsingin-herra",
    "productName": "Helsingin Herra",
    "portable": {
      "artifactName": "Helsingin-Herra-v1.6.3.exe"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!*.md",
      "!.git"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
